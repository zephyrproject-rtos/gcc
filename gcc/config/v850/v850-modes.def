CC_MODE (CCZ);
CC_MODE (CCNZ);
CC_MODE (CC_FPU_LT);
CC_MODE (CC_FPU_LE);
CC_MODE (CC_FPU_GT);
CC_MODE (CC_FPU_GE);
CC_MODE (CC_FPU_EQ);
CC_MODE (CC_FPU_NE);

VECTOR_MODE (FLOAT, SF, 4);
VECTOR_MODE (INT, SI, 4);
ADJUST_ALIGNMENT (V4SF, 16);
ADJUST_ALIGNMENT (V4SI, 16);

ADJUST_ALIGNMENT (DI, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (TI, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (DQ, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (TQ, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (UDQ, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (UTQ, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (DA, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (TA, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (UDA, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (UTA, TARGET_8BYTE_ALIGN ? 8 : 4);
ADJUST_ALIGNMENT (DF, TARGET_8BYTE_ALIGN ? 8 : 4);
